# syntax=docker/dockerfile:1
#
# Development image for the scratchcad service; see ../compose.yaml. It builds
# with the dev profile (debug assertions and overflow checks on, fast
# incremental rebuilds) but with optimisation turned up: the renderer and the
# mesh writers are this crate's own Rust code, which runs many times slower at
# opt-level 0. OpenCASCADE itself is Debian's prebuilt library.
# For the production image, see Dockerfile.

# Keep the Rust version in step with `rust-version` in server/Cargo.toml.
FROM rust:1.99-trixie

# scratchcad-occt-rhai links the system's OpenCASCADE 7.8, which Debian 13
# packages; its build script finds it with CMake.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      cmake \
      libocct-foundation-dev \
      libocct-modeling-data-dev \
      libocct-modeling-algorithms-dev \
      libocct-ocaf-dev \
      libocct-data-exchange-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV CARGO_TARGET_DIR=/target \
    SCRATCHCAD_LISTEN=0.0.0.0:8080 \
    SCRATCHCAD_LOG_FORMAT=text \
    RUST_LOG=info

# Applies to every cargo command in the container without touching Cargo.toml.
RUN printf '[profile.dev]\nopt-level = 2\n\n[profile.dev.package."*"]\nopt-level = 3\n' \
      >> "$CARGO_HOME/config.toml"

# The build context is the repo root (see ../.dockerignore). Build the
# dependencies, including the crates in crates/, first so they are cached
# independently of the server's sources.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY server/Cargo.toml ./server/
RUN mkdir server/src \
 && echo 'fn main() {}' > server/src/main.rs \
 && touch server/src/lib.rs \
 && cargo build --locked -p scratchcad \
 && rm -rf server/src

COPY server/src ./server/src
RUN touch server/src/main.rs server/src/lib.rs && cargo build --locked -p scratchcad

EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=300s --retries=5 \
  CMD ["curl", "-fsS", "http://127.0.0.1:8080/readyz"]
# `cargo run` recompiles on start, so a restart after a source change (which
# `docker compose watch` does automatically) picks up the new code.
CMD ["cargo", "run", "--locked", "-p", "scratchcad"]
